# Personal settings of the dev tools in tools/. Copy to local/dev.env (the whole local/ is git-ignored) and fill in.
# Plain KEY=value lines, no quotes and no $expansion: the shell scripts and the Python ones both read this file.
# A variable already set in the environment wins over the file.

# JDK 21 for Gradle and the desktop app (otherwise the JAVA_HOME of the environment, or java on PATH).
#JAVA_HOME=/path/to/jdk-21
# adb of the Android SDK (otherwise adb on PATH, or ~/Android/Sdk/platform-tools/adb).
#ADB=/path/to/Android/Sdk/platform-tools/adb

# The test TV for tools/tv/env.sh: adb address ip:port (classic adb over TCP is :5555; the port of
# «Беспроводная отладка» changes after a reboot).
TV_ADB=
# Jellyfin server the tools talk to, by its LAN address, e.g. http://192.168.1.10:8096.
JF_URL=
# Test account on that server. Test runs change its watch state; tools/linux/watchdata.py puts it back.
JF_USER=

# Series id for the baseline-profile walk over a series page (gen_profile in tools/tv/env.sh).
PROFILE_SERIES=
# Three consecutive episodes of one season, space-separated ids (S1E2 S1E3 S1E4), for tools/linux/k2.py.
K2_EPISODES=
# Any 1080p video item for tools/linux/l0/float_test.py.
L0_FLOAT_ITEM=
# Test cases of tools/linux/l0/run_all.sh, relative to the repo root: lines "<name> <itemId> [run_case.py options]".
L0_CASES=local/l0-cases.txt
